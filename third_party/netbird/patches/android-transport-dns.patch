diff --git a/client/android/run_cancellation.go b/client/android/run_cancellation.go
new file mode 100644
index 0000000..d47b67f
--- /dev/null
+++ b/client/android/run_cancellation.go
@@ -0,0 +1,32 @@
+package android
+
+import (
+	"context"
+	"sync"
+)
+
+// runCancellation belongs to one native Client instance.
+type runCancellation struct {
+	mu      sync.Mutex
+	cancel  context.CancelFunc
+	stopped bool
+}
+
+func (r *runCancellation) begin(parent context.Context) (context.Context, context.CancelFunc) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	ctx, cancel := context.WithCancel(parent)
+	r.cancel = cancel
+	if r.stopped {
+		cancel()
+	}
+	return ctx, cancel
+}
+func (r *runCancellation) stop() {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.stopped = true
+	if r.cancel != nil {
+		r.cancel()
+	}
+}
diff --git a/client/android/run_cancellation_test.go b/client/android/run_cancellation_test.go
new file mode 100644
index 0000000..755becc
--- /dev/null
+++ b/client/android/run_cancellation_test.go
@@ -0,0 +1,35 @@
+package android
+
+import (
+	"context"
+	"testing"
+)
+
+func TestStopBeforeRunIsRetained(t *testing.T) {
+	var control runCancellation
+	control.stop()
+	ctx, cancel := control.begin(context.Background())
+	defer cancel()
+	if ctx.Err() != context.Canceled {
+		t.Fatal("Stop before native initialization was lost")
+	}
+}
+func TestStopCancelsRunningAndFreshClientRemainsUsable(t *testing.T) {
+	var control runCancellation
+	ctx, cancel := control.begin(context.Background())
+	defer cancel()
+	if ctx.Err() != nil {
+		t.Fatal(ctx.Err())
+	}
+	control.stop()
+	control.stop()
+	if ctx.Err() != context.Canceled {
+		t.Fatal("running engine was not cancelled")
+	}
+	var fresh runCancellation
+	next, done := fresh.begin(context.Background())
+	defer done()
+	if next.Err() != nil {
+		t.Fatal("new client inherited old stop")
+	}
+}
