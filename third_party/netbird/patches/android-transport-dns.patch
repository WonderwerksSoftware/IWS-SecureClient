+++ b/client/net/transport_dns_android.go
@@ -0,0 +1,25 @@
+//go:build android
+
+package net
+
+import (
+	"net"
+	"sync"
+	"time"
+
+	"github.com/netbirdio/netbird/client/net/transportdns"
+)
+
+var transportDNS = transportdns.New((&net.Dialer{
+	Control: ControlProtectSocket,
+	Timeout: 5 * time.Second,
+}).DialContext)
+var transportDNSOnce sync.Once
+
+// SetTransportDNS must first be called before starting native authentication or
+// the engine. Later calls update the synchronized physical-network DNS snapshot.
+// Only Go-native resolution changes; Android/WebView private DNS is untouched.
+func SetTransportDNS(servers []string) error {
+	transportDNSOnce.Do(func() { net.DefaultResolver = transportDNS.Resolver() })
+	return transportDNS.SetServers(servers)
+}
