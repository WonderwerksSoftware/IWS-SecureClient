@@ -0,0 +1,18 @@
+//go:build android
+
+package android
+
+import nbnet "github.com/netbirdio/netbird/client/net"
+
+// SetTransportDNS supplies only DNS servers from a currently usable NOT_VPN
+// Android network. Empty input prevents native DNS until an underlay returns.
+func SetTransportDNS(servers *DNSList) error {
+	if servers == nil {
+		return nbnet.SetTransportDNS(nil)
+	}
+	values := make([]string, 0, len(servers.items))
+	for _, server := range servers.items {
+		values = append(values, server.Addr().String())
+	}
+	return nbnet.SetTransportDNS(values)
+}
