+package transportdns
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"net"
+	"strings"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// A local DNS fixture answers A questions without consulting host/public DNS.
+func dnsFixture(t *testing.T) string {
+	t.Helper()
+	conn, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	go func() {
+		buf := make([]byte, 1500)
+		for {
+			n, from, err := conn.ReadFrom(buf)
+			if err != nil {
+				return
+			}
+			q := append([]byte(nil), buf[:n]...)
+			if n < 17 {
+				continue
+			}
+			end := 12
+			for end < n && q[end] != 0 {
+				end += int(q[end]) + 1
+			}
+			if end+5 > n {
+				continue
+			}
+			kind := binary.BigEndian.Uint16(q[end+1 : end+3])
+			answer := append([]byte(nil), q[:end+5]...)
+			binary.BigEndian.PutUint16(answer[2:4], 0x8180)
+			if kind == 1 {
+				binary.BigEndian.PutUint16(answer[6:8], 1)
+				answer = append(answer, 0xc0, 0x0c, 0, 1, 0, 1, 0, 0, 0, 1, 0, 4, 192, 0, 2, 123)
+			}
+			conn.WriteTo(answer, from)
+		}
+	}()
+	return conn.LocalAddr().String()
+}
+
+func TestLookupUsesSelectedPhysicalDNSAndTracksReplacement(t *testing.T) {
+	fixture := dnsFixture(t)
+	var mu sync.Mutex
+	var targets []string
+	manager := New(func(ctx context.Context, network, target string) (net.Conn, error) {
+		mu.Lock()
+		targets = append(targets, target)
+		mu.Unlock()
+		return (&net.Dialer{}).DialContext(ctx, network, fixture)
+	})
+	for _, server := range []string{"192.0.2.53", "198.51.100.53"} {
+		if err := manager.SetServers([]string{server}); err != nil {
+			t.Fatal(err)
+		}
+		mu.Lock()
+		targets = nil
+		mu.Unlock()
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		ips, err := manager.Resolver().LookupIP(ctx, "ip4", "relay.fixture.invalid")
+		cancel()
+		if err != nil || len(ips) != 1 || ips[0].String() != "192.0.2.123" {
+			t.Fatalf("lookup: %v %v", ips, err)
+		}
+		mu.Lock()
+		if len(targets) == 0 {
+			t.Error("physical resolver never dialed")
+		}
+		for _, target := range targets {
+			if target != net.JoinHostPort(server, "53") {
+				t.Errorf("stale/default resolver %s", target)
+			}
+		}
+		mu.Unlock()
+	}
+}
+
+func TestMissingOrLostPhysicalDNSNeverFallsBack(t *testing.T) {
+	calls := 0
+	manager := New(func(context.Context, string, string) (net.Conn, error) {
+		calls++
+		return nil, errors.New("must not dial")
+	})
+	for _, servers := range [][]string{nil, {}} {
+		if err := manager.SetServers(servers); err != nil {
+			t.Fatal(err)
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		_, err := manager.Resolver().LookupIP(ctx, "ip4", "relay.fixture.invalid")
+		cancel()
+		if err == nil {
+			t.Fatal("DNS unexpectedly succeeded without physical network")
+		}
+	}
+	if calls != 0 {
+		t.Fatalf("default resolver dialed %d times", calls)
+	}
+}
+
+func TestInvalidResolversFailClosed(t *testing.T) {
+	manager := New(func(context.Context, string, string) (net.Conn, error) { return nil, errors.New("not connected") })
+	for _, server := range []string{"relay.netbird.io", "127.0.0.1", "0.0.0.0", "224.0.0.1", "::1", "192.0.2.53:53"} {
+		if manager.SetServers([]string{server}) == nil {
+			t.Errorf("accepted %s", server)
+		}
+	}
+}
+
+func TestProtectionFailureCannotUseUnprotectedFallback(t *testing.T) {
+	calls := 0
+	manager := New(func(context.Context, string, string) (net.Conn, error) {
+		calls++
+		return nil, fmt.Errorf("socket protection refused")
+	})
+	if err := manager.SetServers([]string{"192.0.2.53"}); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	_, err := manager.Resolver().LookupIP(ctx, "ip4", "relay.fixture.invalid")
+	if err == nil || !strings.Contains(err.Error(), "socket protection refused") || calls == 0 {
+		t.Fatalf("missing protected failure: %v calls=%d", err, calls)
+	}
+}
+
+func TestDefaultResolverCoversDirectUDPAndDataDialerLookups(t *testing.T) {
+	fixture := dnsFixture(t)
+	manager := New(func(ctx context.Context, network, target string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, network, fixture)
+	})
+	if err := manager.SetServers([]string{"192.0.2.53"}); err != nil {
+		t.Fatal(err)
+	}
+	previous := net.DefaultResolver
+	net.DefaultResolver = manager.Resolver()
+	defer func() { net.DefaultResolver = previous }()
+	address, err := net.ResolveUDPAddr("udp4", "relay.fixture.invalid:443")
+	if err != nil || address.IP.String() != "192.0.2.123" {
+		t.Fatalf("direct QUIC lookup: %v %v", address, err)
+	}
+	protected := false
+	dialer := net.Dialer{Control: func(network, address string, c syscall.RawConn) error {
+		protected = true
+		if address != "192.0.2.123:443" {
+			t.Errorf("unexpected resolved destination %s", address)
+		}
+		return errors.New("fixture stops before network connection")
+	}}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	_, err = dialer.DialContext(ctx, "tcp4", "signal.fixture.invalid:443")
+	if err == nil || !protected {
+		t.Fatalf("data socket protection not reached after DNS: %v", err)
+	}
+}
