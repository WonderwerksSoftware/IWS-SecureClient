index 0000000..1049b75
--- /dev/null
+++ b/client/net/transportdns/resolver.go
@@ -0,0 +1,74 @@
+// Package transportdns keeps native transport lookups independent of the app VPN.
+package transportdns
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync"
+)
+
+type DialFunc func(context.Context, string, string) (net.Conn, error)
+
+type Manager struct {
+	mu       sync.Mutex
+	servers  []string
+	next     uint64
+	dial     DialFunc
+	resolver *net.Resolver
+}
+
+// New requires a dial function that protects and binds each DNS socket to the
+// selected physical network. There is deliberately no system/public fallback.
+func New(dial DialFunc) *Manager {
+	m := &Manager{dial: dial}
+	m.resolver = &net.Resolver{PreferGo: true, Dial: m.dialDNS}
+	return m
+}
+
+func (m *Manager) Resolver() *net.Resolver { return m.resolver }
+
+// SetServers replaces the physical-network DNS snapshot. Invalid/empty input
+// clears old servers so a stale network can never be used as a fallback.
+func (m *Manager) SetServers(servers []string) error {
+	var validated []string
+	var validationError error
+	for _, value := range servers {
+		ip := net.ParseIP(value)
+		if ip == nil || ip.To4() == nil || ip.IsLoopback() || ip.IsUnspecified() || ip.IsMulticast() {
+			validationError = errors.New("invalid physical IPv4 DNS resolver")
+			validated = nil
+			break
+		}
+		normalized := ip.String()
+		found := false
+		for _, existing := range validated {
+			if existing == normalized {
+				found = true
+				break
+			}
+		}
+		if !found {
+			validated = append(validated, normalized)
+		}
+	}
+	m.mu.Lock()
+	m.servers = validated
+	m.next = 0
+	m.mu.Unlock()
+	return validationError
+}
+
+func (m *Manager) dialDNS(ctx context.Context, network, _ string) (net.Conn, error) {
+	m.mu.Lock()
+	if len(m.servers) == 0 {
+		m.mu.Unlock()
+		return nil, errors.New("physical network DNS unavailable")
+	}
+	server := m.servers[m.next%uint64(len(m.servers))]
+	m.next++
+	m.mu.Unlock()
+	// Resolver's address argument comes from system resolver configuration, which
+	// belongs to the IWS VPN on Android. Only the physical snapshot is admitted.
+	return m.dial(ctx, network, net.JoinHostPort(server, "53"))
+}
